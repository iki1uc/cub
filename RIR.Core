export const RIR = {

  // 1. Existenzprüfung
  exist(input) {
    return input !== undefined && input !== null;
  },

  // 2. Strukturprüfung
  structure(input) {
    if (typeof input !== "object") return false;
    return ["x", "y", "z"].every(key => key in input);
  },

  // 3. Reinheitsprüfung
  purity(input) {
    const { x, y, z } = input;
    return Number.isFinite(x) && Number.isFinite(y) && Number.isFinite(z);
  },

  // 4. Filter: alles zusammen
  filter(input) {
    if (!this.exist(input)) return null;
    if (!this.structure(input)) return null;
    if (!this.purity(input)) return null;
    return input;
  },

  // 5. Rückgabe: nur reine Impulse
  return(input) {
    const packet = this.filter(input);
    if (!packet) return { RIR: "reject" };
    return { RIR: "accept", packet };
  },

  // 6. Rad‑Antrieb (Rotation)
  rad(input) {
    const p = this.filter(input);
    if (!p) return { rad: "reject" };

    const rot = (p.x + p.y + p.z) % 360;
    return { rad: "rotate", deg: rot };
  },

  // 7. Uhr‑Antrieb (Takt)
  uhr(input) {
    const p = this.filter(input);
    if (!p) return { uhr: "reject" };

    const tick = Math.abs(p.x * 3 + p.y * 9 + p.z * 27);
    return { uhr: "tick", ms: tick };
  },

  // 8. Treibstoff‑Antrieb (Energiefluss)
  fuel(input) {
    const p = this.filter(input);
    if (!p) return { fuel: "reject" };

    const energy = Math.sqrt(p.x ** 2 + p.y ** 2 + p.z ** 2);
    return { fuel: "flow", joule: energy };
  },

  // 9. Gesamt‑Antrieb (Drive)
  drive(input) {
    return {
      RIR: this.return(input),
      rad: this.rad(input),
      uhr: this.uhr(input),
      fuel: this.fuel(input),
      timestamp: new Date().toISOString()
    };
  }
};
