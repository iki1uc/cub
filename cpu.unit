export const CPU_UNIT = {

  // 1. Numerische Gegenmenge
  numeric(x) {
    return -x;
  },

  // 2. Axiomatische Gegenmenge
  axiom(a) {
    const map = {
      "AH": "HA", "HA": "AH",
      "ÄH": "HÄ", "HÄ": "ÄH",
      "IX": "XI", "XI": "IX",
      "OI": "IO", "IO": "OI",
      "AIR": "AIV", "AIV": "AIR"
    };
    return map[a] || null;
  },

  // 3. Symbolische Gegenmenge
  symbol(s) {
    const map = {
      "◉": "◎", "◎": "◉",
      "◆": "△", "△": "◆",
      "▣": "27", "27": "▣",
      "3↺": "81", "81": "3↺"
    };
    return map[s] || null;
  },

  // 4. Richtungs-Gegenmenge
  vector(v) {
    const map = {
      "N": "S", "S": "N",
      "E": "W", "W": "E",
      "NE": "SW", "SW": "NE",
      "NW": "SE", "SE": "NW",
      "CENTER": "O", "O": "CENTER"
    };
    return map[v] || null;
  },

  // 5. Universal-Gegenmenge
  unit(input) {
    if (typeof input === "number") return this.numeric(input);
    if (typeof input === "string") {
      return (
        this.axiom(input) ||
        this.symbol(input) ||
        this.vector(input) ||
        null
      );
    }
    return null;
  }
};

